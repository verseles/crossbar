<?xml version="1.0" encoding="utf-8"?>
<!-- Medium Widget Layout (2x1): Icon + Title + Value + Action area -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp"
    tools:ignore="Overdraw">

    <!-- Icon/Emoji on the left -->
    <TextView
        android:id="@+id/widget_icon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="16dp"
        android:gravity="center"
        android:text="📊"
        android:textSize="36sp" />

    <!-- Text content in the middle (takes remaining space) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Plugin Title -->
        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Plugin"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp"
            android:letterSpacing="0.02" />

        <!-- Main Value -->
        <TextView
            android:id="@+id/widget_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="--"
            android:textColor="@color/widget_text_primary"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />

        <!-- Subtitle/Description (optional) -->
        <TextView
            android:id="@+id/widget_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text=""
            android:textColor="@color/widget_text_tertiary"
            android:textSize="11sp"
            android:layout_marginTop="2dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Action buttons on the right (stacked vertically) -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Edit action -->
        <ImageView
            android:id="@+id/widget_edit"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_edit_widget"
            android:padding="2dp"
            android:src="@drawable/ic_edit"
            android:tint="@color/widget_icon_tint"
            tools:ignore="UseAppTint" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <!-- Menu button (visible when plugin has menu items) -->
        <ImageView
            android:id="@+id/widget_menu"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_plugin_menu"
            android:padding="2dp"
            android:src="@drawable/ic_more_vert"
            android:tint="@color/widget_icon_tint"
            android:visibility="gone"
            tools:ignore="UseAppTint" />

    </LinearLayout>

</LinearLayout>
