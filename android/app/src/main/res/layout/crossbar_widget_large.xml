<?xml version="1.0" encoding="utf-8"?>
<!-- Large Widget Layout (2x2): List of plugins - Simplified for RemoteViews compatibility -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Header - Text only, no ImageView to avoid RemoteViews issues -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <!-- Title -->
        <TextView
            android:id="@+id/widget_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Crossbar"
            android:textColor="@color/widget_text_primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Edit action -->
        <ImageView
            android:id="@+id/widget_edit"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_edit_widget"
            android:padding="2dp"
            android:src="@drawable/ic_edit"
            android:tint="@color/widget_icon_tint" />

    </LinearLayout>

    <!-- Plugin List Container -->
    <LinearLayout
        android:id="@+id/widget_list_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Plugin Item 1 -->
        <LinearLayout
            android:id="@+id/plugin_item_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp">

            <TextView
                android:id="@+id/plugin_1_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="📊"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/plugin_1_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Plugin 1"
                android:textColor="@color/widget_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/plugin_1_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/plugin_1_menu"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_plugin_menu"
                android:src="@drawable/ic_more_vert"
                android:tint="@color/widget_icon_tint"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Plugin Item 2 -->
        <LinearLayout
            android:id="@+id/plugin_item_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/plugin_2_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="📊"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/plugin_2_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Plugin 2"
                android:textColor="@color/widget_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/plugin_2_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/plugin_2_menu"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_plugin_menu"
                android:src="@drawable/ic_more_vert"
                android:tint="@color/widget_icon_tint"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Plugin Item 3 -->
        <LinearLayout
            android:id="@+id/plugin_item_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/plugin_3_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="📊"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/plugin_3_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Plugin 3"
                android:textColor="@color/widget_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/plugin_3_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/plugin_3_menu"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_plugin_menu"
                android:src="@drawable/ic_more_vert"
                android:tint="@color/widget_icon_tint"
                android:visibility="gone" />

        </LinearLayout>

        <!-- Plugin Item 4 -->
        <LinearLayout
            android:id="@+id/plugin_item_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/plugin_4_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="📊"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/plugin_4_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Plugin 4"
                android:textColor="@color/widget_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/plugin_4_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/widget_text_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/plugin_4_menu"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="4dp"
                android:background="?android:attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/action_plugin_menu"
                android:src="@drawable/ic_more_vert"
                android:tint="@color/widget_icon_tint"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <!-- Footer: Last updated -->
    <TextView
        android:id="@+id/widget_last_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="end"
        android:text="Updated just now"
        android:textColor="@color/widget_text_tertiary"
        android:textSize="10sp" />

</LinearLayout>
