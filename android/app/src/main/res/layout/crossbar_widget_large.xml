<?xml version="1.0" encoding="utf-8"?>
<!-- Large Widget Layout (2x2 or bigger): List of plugins -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp"
    tools:ignore="Overdraw">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <!-- App Icon -->
        <ImageView
            android:id="@+id/widget_app_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="10dp"
            android:contentDescription="Crossbar"
            android:src="@mipmap/ic_launcher" />

        <!-- Title -->
        <TextView
            android:id="@+id/widget_header_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Crossbar"
            android:textColor="@color/widget_text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:letterSpacing="0.01" />

        <!-- Refresh button -->
        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_refresh"
            android:padding="2dp"
            android:src="@drawable/ic_refresh"
            android:tint="@color/widget_icon_tint"
            tools:ignore="UseAppTint" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginBottom="12dp"
        android:background="@color/widget_divider" />

    <!-- Plugin List Container -->
    <LinearLayout
        android:id="@+id/widget_list_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Plugin Item 1 -->
        <LinearLayout
            android:id="@+id/plugin_item_1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="6dp">

            <TextView
                android:id="@+id/plugin_1_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="📊"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/plugin_1_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Plugin 1"
                android:textColor="@color/widget_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/plugin_1_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Plugin Item 2 -->
        <LinearLayout
            android:id="@+id/plugin_item_2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/plugin_2_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="📊"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/plugin_2_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Plugin 2"
                android:textColor="@color/widget_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/plugin_2_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Plugin Item 3 -->
        <LinearLayout
            android:id="@+id/plugin_item_3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/plugin_3_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="📊"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/plugin_3_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Plugin 3"
                android:textColor="@color/widget_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/plugin_3_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Plugin Item 4 -->
        <LinearLayout
            android:id="@+id/plugin_item_4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="6dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/plugin_4_icon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="12dp"
                android:text="📊"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/plugin_4_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Plugin 4"
                android:textColor="@color/widget_text_secondary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/plugin_4_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textColor="@color/widget_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

    <!-- Footer: Last updated -->
    <TextView
        android:id="@+id/widget_last_updated"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="end"
        android:text="Updated just now"
        android:textColor="@color/widget_text_tertiary"
        android:textSize="10sp" />

</LinearLayout>
