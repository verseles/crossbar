{
  "name": "GitHub Notifications",
  "description": "Shows your unread GitHub notifications count.",
  "icon": "GH",
  "config_required": "required",
  "settings": [
    {
      "key": "_info_token",
      "label": "Token Scope",
      "type": "info",
      "format": "info",
      "description": "Create a personal access token at github.com/settings/tokens with the 'notifications' scope."
    },
    {
      "key": "GITHUB_TOKEN",
      "label": "GitHub Token",
      "type": "password",
      "required": true,
      "placeholder": "ghp_xxxxxxxxxxxxxxxxxxxx",
      "help": "Needs notifications scope."
    },
    {
      "key": "_sep1",
      "label": "",
      "type": "separator"
    },
    {
      "key": "GITHUB_MAX_ITEMS",
      "label": "Max items",
      "type": "slider",
      "default": "5",
      "min": 1,
      "max": 50,
      "step": 1
    }
  ]
}
