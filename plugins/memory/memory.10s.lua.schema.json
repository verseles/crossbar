{
  "name": "Memory Monitor (Lua)",
  "description": "Shows memory usage with thresholds and optional details.",
  "icon": "MEM",
  "config_required": "optional",
  "settings": [
    {
      "key": "_sec_thresholds",
      "label": "Thresholds",
      "type": "section"
    },
    {
      "key": "MEM_WARN",
      "label": "Warning threshold",
      "type": "slider",
      "default": "70",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "%",
      "help": "Usage >= warn uses yellow"
    },
    {
      "key": "MEM_CRIT",
      "label": "Critical threshold",
      "type": "slider",
      "default": "85",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "%",
      "help": "Usage >= crit uses red"
    },
    {
      "key": "_sep1",
      "label": "",
      "type": "separator"
    },
    {
      "key": "MEM_SHOW_RAW",
      "label": "Show raw string",
      "type": "switch",
      "default": "false"
    },
    {
      "key": "MEM_SHOW_TOTAL",
      "label": "Show total memory",
      "type": "switch",
      "default": "true"
    }
  ]
}
