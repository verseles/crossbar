{
  "name": "Pomodoro",
  "description": "Pomodoro timer with work/break cycles.",
  "icon": "POMO",
  "config_required": "optional",
  "settings": [
    {
      "key": "_sec_durations",
      "label": "Timer Durations",
      "type": "section"
    },
    {
      "key": "POMODORO_WORK_MINS",
      "label": "Work minutes",
      "type": "slider",
      "default": "25",
      "min": 1,
      "max": 180,
      "step": 1,
      "unit": "m"
    },
    {
      "key": "POMODORO_BREAK_MINS",
      "label": "Break minutes",
      "type": "slider",
      "default": "5",
      "min": 1,
      "max": 60,
      "step": 1,
      "unit": "m"
    },
    {
      "key": "POMODORO_ALERT_RANGE",
      "label": "Alert at remaining minutes",
      "type": "range",
      "default": "1,5",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "m",
      "help": "Show orange color when remaining time is within this range."
    },
    {
      "key": "_sep1",
      "label": "",
      "type": "separator"
    },
    {
      "key": "POMODORO_STATE_FILE",
      "label": "State file",
      "type": "path",
      "default": "~/.crossbar/pomodoro.state"
    }
  ]
}
