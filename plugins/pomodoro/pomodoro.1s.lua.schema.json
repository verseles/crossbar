{
  "name": "Pomodoro (Lua)",
  "description": "Pomodoro timer with work/break cycles.",
  "icon": "POMO",
  "config_required": "optional",
  "settings": [
    {
      "key": "POMODORO_WORK_MINS",
      "label": "Work minutes",
      "type": "slider",
      "default": "25",
      "min": 1,
      "max": 180,
      "step": 1,
      "unit": "m"
    },
    {
      "key": "POMODORO_BREAK_MINS",
      "label": "Break minutes",
      "type": "slider",
      "default": "5",
      "min": 1,
      "max": 60,
      "step": 1,
      "unit": "m"
    },
    {
      "key": "POMODORO_STATE_FILE",
      "label": "State file",
      "type": "path",
      "default": "~/.crossbar/pomodoro.state"
    }
  ]
}
