{
  "name": "CPU Monitor",
  "description": "Shows CPU usage with thresholds and optional details.",
  "icon": "CPU",
  "config_required": "optional",
  "settings": [
    {
      "key": "_info_android",
      "label": "Android",
      "type": "info",
      "format": "warning",
      "description": "CPU monitoring is unavailable on Android 8+ due to SELinux restrictions."
    },
    {
      "key": "_sec_thresholds",
      "label": "Thresholds",
      "type": "section"
    },
    {
      "key": "CPU_WARN",
      "label": "Warning threshold",
      "type": "slider",
      "default": "60",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "%",
      "help": "Usage >= warn uses yellow"
    },
    {
      "key": "CPU_CRIT",
      "label": "Critical threshold",
      "type": "slider",
      "default": "80",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "%",
      "help": "Usage >= crit uses red"
    },
    {
      "key": "_sep1",
      "label": "",
      "type": "separator"
    },
    {
      "key": "CPU_SHOW_PLATFORM",
      "label": "Show platform",
      "type": "switch",
      "default": "true"
    },
    {
      "key": "CPU_SHOW_RAW",
      "label": "Show 1-decimal value",
      "type": "switch",
      "default": "false"
    }
  ]
}
