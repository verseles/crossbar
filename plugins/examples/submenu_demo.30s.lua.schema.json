{
  "name": "Submenu Demo",
  "description": "Demonstrates nested menu rendering.",
  "icon": "MENU",
  "config_required": "optional",
  "settings": [
    {
      "key": "SUBMENU_SHOW_ENV",
      "label": "Show environment section",
      "type": "switch",
      "default": "true"
    },
    {
      "key": "SUBMENU_TITLE",
      "label": "Menu title",
      "type": "text",
      "default": "System"
    },
    {
      "key": "SUBMENU_CUSTOM_HEADER",
      "label": "Custom header lines",
      "type": "code",
      "format": "text",
      "default": "",
      "rows": 3,
      "help": "Raw BitBar lines added at the top. One per row."
    },
    {
      "key": "SUBMENU_ICON_PATH",
      "label": "Custom icon",
      "type": "image",
      "default": "",
      "accept": ".png,.jpg,.svg",
      "help": "Optional image for the menu title bar."
    }
  ]
}
