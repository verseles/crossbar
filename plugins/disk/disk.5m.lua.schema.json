{
  "name": "Disk Usage (Lua)",
  "description": "Shows disk usage for a path.",
  "icon": "DISK",
  "config_required": "optional",
  "settings": [
    {
      "key": "_info_desktop",
      "label": "Desktop Only",
      "type": "info",
      "format": "warning",
      "description": "Disk usage monitoring requires shell access and is only available on desktop platforms."
    },
    {
      "key": "DISK_PATH",
      "label": "Path",
      "type": "path",
      "default": "/",
      "help": "Directory to inspect. Use C:\\ on Windows."
    },
    {
      "key": "_sep1",
      "label": "",
      "type": "separator"
    },
    {
      "key": "DISK_WARN",
      "label": "Warning threshold",
      "type": "slider",
      "default": "75",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "%"
    },
    {
      "key": "DISK_CRIT",
      "label": "Critical threshold",
      "type": "slider",
      "default": "90",
      "min": 1,
      "max": 100,
      "step": 1,
      "unit": "%"
    }
  ]
}
