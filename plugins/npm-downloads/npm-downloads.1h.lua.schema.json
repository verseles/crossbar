{
  "name": "NPM Downloads",
  "description": "Shows weekly downloads for a package.",
  "icon": "NPM",
  "config_required": "optional",
  "settings": [
    {
      "key": "NPM_PACKAGE",
      "label": "Package name",
      "type": "text",
      "default": "lodash",
      "pattern": "^[a-z0-9@._/-]+$",
      "help": "Examples: lodash, @scope/package"
    }
  ]
}
